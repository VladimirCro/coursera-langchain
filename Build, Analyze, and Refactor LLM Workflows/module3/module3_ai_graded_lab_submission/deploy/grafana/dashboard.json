{
  "uid": "rag-prod-sla",
  "title": "GlobalAI — RAG Production SLA Dashboard",
  "tags": ["rag", "sla", "production"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "p95 Latency (SLA: < 2s)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rag_request_latency_seconds_bucket[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1.5 },
              { "color": "red", "value": 2.0 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "p50 / p95 / p99 Latency",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(rag_request_latency_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(rag_request_latency_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(rag_request_latency_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cache Hit Rate",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": "${datasource}",
      "targets": [{ "expr": "rag_cache_hit_rate", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.30 },
              { "color": "green", "value": 0.50 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cost — last 1h (extrapolated /mo)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "rate(rag_cost_usd_total[1h]) * 86400 * 30", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 35000 },
              { "color": "red", "value": 50000 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request Latency Percentiles",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(rag_request_latency_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(rag_request_latency_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(rag_request_latency_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests per Second (by status)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "sum by (status) (rate(rag_requests_total[1m]))", "legendFormat": "{{status}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cache Hits vs Misses (tier breakdown)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "sum by (tier) (rate(rag_cache_hits_total[5m]))", "legendFormat": "hit - {{tier}}", "refId": "A" },
        { "expr": "rate(rag_cache_misses_total[5m])", "legendFormat": "miss", "refId": "B" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Token Consumption per minute",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "rate(rag_tokens_total{type=\"input\"}[1m]) * 60", "legendFormat": "input tok/min", "refId": "A" },
        { "expr": "rate(rag_tokens_total{type=\"output\"}[1m]) * 60", "legendFormat": "output tok/min", "refId": "B" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Pod Replica Count (HPA)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "kube_deployment_status_replicas{deployment=\"rag-service\",namespace=\"rag\"}", "legendFormat": "current", "refId": "A" },
        { "expr": "kube_deployment_spec_replicas{deployment=\"rag-service\",namespace=\"rag\"}", "legendFormat": "desired", "refId": "B" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Cost Burn Rate ($/hr)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": "${datasource}",
      "targets": [
        { "expr": "rate(rag_cost_usd_total[5m]) * 3600", "legendFormat": "$/hr", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    }
  ]
}
