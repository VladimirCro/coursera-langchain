{
  "model": {
    "provider": "openai",
    "name": "gpt-4o-mini",
    "temperature": 0.0,
    "max_tokens": 512,
    "response_generation_temperature": 0.7,
    "response_generation_max_tokens": 300
  },
  "thresholds": {
    "high_confidence": 0.85,
    "medium_confidence": 0.60,
    "low_confidence": 0.40,
    "auto_escalate_below_confidence": 0.40
  },
  "valid_intents": [
    "billing",
    "technical_support",
    "account_management",
    "general_inquiry",
    "complaint",
    "escalation",
    "cancellation",
    "unknown"
  ],
  "valid_sentiments": ["positive", "neutral", "negative", "very_negative"],
  "valid_urgencies": ["low", "medium", "high", "critical"],
  "valid_emotions": ["calm", "frustrated", "angry", "confused", "satisfied"],
  "auto_escalate_intents": ["escalation"],
  "auto_escalate_sentiments": ["very_negative"],
  "batch": {
    "max_concurrency": 5,
    "retry_attempts": 3,
    "retry_delay_seconds": 1.0
  },
  "logging": {
    "level": "INFO",
    "log_prompts": false,
    "log_raw_responses": false
  }
}
