# =============================================================================
# Environment Variables - Copy this file to .env and fill in your values
# =============================================================================
# IMPORTANT: Never commit .env to version control!
# =============================================================================

# OpenAI API Key (required if using OpenAI provider)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (required if using Anthropic/Claude provider)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Model provider: "openai" or "anthropic"
LLM_PROVIDER=openai

# Override model name (optional - defaults to value in config.json)
# LLM_MODEL_NAME=gpt-4o

# Override temperature (optional)
# LLM_TEMPERATURE=0.0

# Path to config files (optional - defaults to ./config/)
# CONFIG_DIR=./config

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
